# Copy to .env for local Compose overrides.
# Only cloud secret required for Phase 1 agent work (stub chat does not call LLM yet).
LLM_API_KEY=your_actual_openai_or_anthropic_key_here

# Which services stream logs during `docker compose up` (default: all true).
# Set false to hide a service's logs while still starting it.
COMPOSE_ATTACH_DB=true
COMPOSE_ATTACH_VECTOR_DB=true
COMPOSE_ATTACH_BACKEND_CORE=true
COMPOSE_ATTACH_AGENT_SERVICE=true
COMPOSE_ATTACH_DASHBOARD_UI=true
COMPOSE_ATTACH_CHAT_WIDGET=true
